// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

/// Platform user — a student or teacher registered on Pythagoras.
model User {
  id          String   @id @default(cuid())
  email       String   @unique
  name        String?
  /// Role: "student", "teacher", "admin"
  role        String   @default("student")
  /// Anonymous display name shown in admin (e.g. "طالب #1234")
  displayName String?
  /// Grade level: "6" (6th grade — the current target)
  grade       String?
  /// Is the user active (has logged in within last 30 days)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  subscriptions PremiumSubscription[]

  @@index([role])
  @@index([createdAt])
}

/// Premium subscription — tracks who pays and when.
model PremiumSubscription {
  id        String   @id @default(cuid())
  userId    String
  /// Plan: "monthly", "yearly", "lifetime"
  plan      String   @default("monthly")
  /// Status: "active", "cancelled", "expired", "pending"
  status    String   @default("active")
  /// Price paid in IQD (Iraqi Dinar)
  price     Int      @default(0)
  /// When the subscription started
  startedAt DateTime @default(now())
  /// When the subscription ends (null = lifetime)
  endsAt    DateTime?
  /// Payment method: "manual", "bank", "card", "other"
  paymentMethod String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@index([startedAt])
}

/// Analytics event — the core of the event system.
model AnalyticsEvent {
  id        String   @id @default(cuid())
  type      String
  timestamp DateTime @default(now())
  userId    String?
  sessionId String?
  entityId  String?
  platform  String?
  version   String?
  device    String?
  metadata  String?

  @@index([type])
  @@index([timestamp])
  @@index([userId])
  @@index([entityId])
}
