+    };
+    const move = event => {
+      if (!pointers.has(event.pointerId) || !stage || !viewport) return;
+      consume(event);
+      pointers.set(event.pointerId, position(event));
+      const points = [...pointers.values()];
+      if (points.length === 1 && panStart) {
