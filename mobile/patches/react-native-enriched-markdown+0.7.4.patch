+  // Optional app semantics color UIKit's own track/capsule, never replace them.
+  func applyControlColors(surface: UIColor?, selectedSurface: UIColor?, pressedSurface: UIColor?,
+    foreground: UIColor?, selectedForeground: UIColor?, border: UIColor?) {
+    backgroundColor = surface
+    selectedSegmentTintColor = selectedSurface
+    layer.borderColor = border?.cgColor
+    controlForeground = foreground
+    self.selectedForeground = selectedForeground
+    if let foreground { tintColor = foreground }
+    setTitleTextAttributes(foreground.map { [.foregroundColor: $0] }, for: .normal)
+    setTitleTextAttributes(selectedForeground.map { [.foregroundColor: $0] }, for: .selected)
+    setTitleTextAttributes(selectedForeground.map { [.foregroundColor: $0] }, for: .highlighted)
+    // UIKit retains pressed feedback; no touch or selected-indicator overrides.
+    if !appearanceTargetInstalled {
+      for index in 0..<numberOfSegments {
+        if let image = imageForSegment(at: index) { originalImages[index] = image }
+      }
+      addTarget(self, action: #selector(refreshControlForeground), for: .valueChanged)
+      appearanceTargetInstalled = true
+    }
+    refreshControlForeground()
+  }
+
+  @objc func refreshControlForeground() {
+    for (index, image) in originalImages {
+      let color = index == selectedSegmentIndex ? selectedForeground : controlForeground
+      let colored = color.map { image.withTintColor($0, renderingMode: .alwaysOriginal) } ?? image
+      colored.accessibilityLabel = image.accessibilityLabel
+      setImage(colored, forSegmentAt: index)
+    }
+  }
+
+  override func point(inside point: CGPoint, with event: UIEvent?) -> Bool {
+    bounds.insetBy(dx: 0, dy: -4).contains(point)
+  }
+}
