+      @"rust": @"Rust", @"rs": @"Rust", @"go": @"Go", @"golang": @"Go", @"yaml": @"YAML", @"yml": @"YAML", @"xml": @"XML", @"markdown": @"Markdown", @"md": @"Markdown",
+      @"jsonc": @"JSONC", @"toml": @"TOML", @"ini": @"INI", @"powershell": @"PowerShell", @"ps1": @"PowerShell", @"pwsh": @"PowerShell", @"cmd": @"CMD", @"bat": @"CMD", @"batch": @"CMD", @"dos": @"CMD",
+      @"objc": @"Objective-C", @"objective-c": @"Objective-C", @"objectivec": @"Objective-C", @"php": @"PHP", @"ruby": @"Ruby", @"rb": @"Ruby", @"lua": @"Lua", @"r": @"R", @"matlab": @"MATLAB", @"dart": @"Dart", @"scala": @"Scala",
