+
+// Upstream issue #824: Fabric may measure before async GFM segments exist on iOS.
+- (void)validateHeightForCurrentWidth:(CGFloat)width
+{
+  if (width <= 0) {
+    if (_renderedMarkdown != nil) {
+      _pendingHeightValidation = YES;
+    }
+    return;
+  }
+
+  CGFloat scale = RCTScreenScale();
+  BOOL widthChanged = !_hasValidatedWidth || ceil(width * scale) != ceil(_lastValidatedWidth * scale);
+  if (_renderedMarkdown == nil && !_pendingHeightValidation && !_pendingForceHeightUpdate) {
+    _lastValidatedWidth = width;
+    _hasValidatedWidth = YES;
+    return;
+  }
+  if (!_pendingHeightValidation && _validatedRenderRevision == _renderRevision && !widthChanged &&
+      !_pendingForceHeightUpdate) {
+    return;
+  }
+
+  CGSize measured = [self measureSize:width];
+  BOOL shouldRequestHeightUpdate = _pendingForceHeightUpdate || needsHeightUpdate(measured, self.bounds);
+
+  // Record the measured revision before invalidating Yoga so its next layout pass
+  // cannot recursively request another update for the same content and width.
+  _validatedRenderRevision = _renderRevision;
+  _lastValidatedWidth = width;
+  _hasValidatedWidth = YES;
+  _pendingHeightValidation = NO;
+  _pendingForceHeightUpdate = NO;
+
+  if (shouldRequestHeightUpdate) {
+    [self requestHeightUpdate];
     }
