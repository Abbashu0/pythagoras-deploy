+  })();
+  """#
+
+  // This runs only in the internally owned Mermaid engine content world.
+  // Capture precedes MermaidKit's viewport bubble handlers, keeping its pinned
+  // renderer/zoom-to-fit API while replacing the faulty pointer translation.
+  private static let interactionScript = #"""
+  (() => {
+    if (window.__pythagorasMermaidInteraction) return;
+    const minimumScale = __ENRM_MIN_SCALE__, maximumScale = __ENRM_MAX_SCALE__;
+    const pointers = new Map();
+    let gestureClaimed = false;
+    let stage = null, viewport = null, scale = 1, tx = 0, ty = 0, panStart = null, pinchStart = null;
+    const clampScale = value => Math.min(maximumScale, Math.max(minimumScale, value));
+    const status = value => { try { window.webkit.messageHandlers.pythagorasMermaidRendered.postMessage(value); } catch (_) {} };
+    const consume = event => { if (event.cancelable) event.preventDefault(); event.stopImmediatePropagation(); };
+    const findSurface = event => {
+      const candidate = document.getElementById('viewport');
+      const target = document.getElementById('stage');
+      if (!candidate || !target || !(event.target instanceof Node) || !candidate.contains(event.target)) return false;
+      viewport = candidate; stage = target; return true;
+    };
