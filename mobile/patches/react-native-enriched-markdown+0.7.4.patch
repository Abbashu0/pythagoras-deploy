+import Foundation
+
+#if os(iOS)
+import UIKit
+import CryptoKit
+import Highlighter
+
+// A request owns no view. Cancellation is checked both before grammar work and delivery.
+@objc(ENRMSyntaxHighlightRequest)
+public final class ENRMSyntaxHighlightRequest: NSObject, @unchecked Sendable {
+  private let lock = NSLock()
+  private var cancelled = false
+
+  @objc public func cancel() {
+    lock.lock()
+    cancelled = true
+    lock.unlock()
+  }
+
+  fileprivate var isCancelled: Bool {
+    lock.lock()
+    defer { lock.unlock() }
+    return cancelled
+  }
+}
+
+@objc(ENRMSyntaxHighlighterBridge)
+public final class ENRMSyntaxHighlighterBridge: NSObject {
+  private static let service = SyntaxHighlightService()
+
+  @objc(requestColorsForSource:language:dark:clientID:completion:)
+  public static func requestColors(
+    forSource source: String, language: String, dark: Bool, clientID: String,
+    completion: @escaping (NSAttributedString?) -> Void
+  ) -> ENRMSyntaxHighlightRequest {
+    let request = ENRMSyntaxHighlightRequest()
+    service.submit(source: source, language: language, dark: dark, clientID: clientID,
+                   request: request, completion: completion)
+    return request
+  }
+}
+
+private final class SyntaxHighlightService: @unchecked Sendable {
+  // Immutable inputs; cancellation is locked and the ObjC completion runs only on main.
+  private struct Job: @unchecked Sendable {
+    let source: String
+    let language: String
+    let dark: Bool
+    let request: ENRMSyntaxHighlightRequest
+    let completion: (NSAttributedString?) -> Void
+  }
+  private struct CachedResult {
+    let colors: NSAttributedString
+    let cost: Int
+  }
+  private struct Delivery: @unchecked Sendable {
+    let colors: NSAttributedString? // Immutable foreground-only snapshot.
+  }
+
+  private let queue = DispatchQueue(label: "com.pythagoras.markdown.syntax", qos: .utility)
+  private let pendingLock = NSLock()
+  private var pending: [String: Job] = [:]
+  private var pendingOrder: [String] = []
+  private var draining = false
+  private let maximumSourceUTF16 = 32768
+  private let maximumPendingClients = 128
+  private let maximumCacheEntries = 64
+  private let maximumCacheCost = 2 * 1024 * 1024
+
+  // Only the serial queue accesses the engine, themes and cache.
+  private var initialized = false
+  private var engine: Highlighter?
+  private var supported: Set<String> = []
+  private var activeDark: Bool?
+  private var cache: [String: CachedResult] = [:]
+  private var recency: [String] = []
+  private var cacheCost = 0
+
+  func submit(source: String, language: String, dark: Bool, clientID: String,
+              request: ENRMSyntaxHighlightRequest, completion: @escaping (NSAttributedString?) -> Void) {
+    let job = Job(source: source, language: language, dark: dark, request: request, completion: completion)
+    guard (source as NSString).length <= maximumSourceUTF16 else {
+      DispatchQueue.main.async { if !job.request.isCancelled { job.completion(nil) } }
+      return
+    }
+    pendingLock.lock()
+    // A streaming view replaces its pending job rather than enqueueing every delta.
+    if let old = pending[clientID] {
+      old.request.cancel()
+    } else {
+      if pending.count >= maximumPendingClients, let oldest = pendingOrder.first {
+        pending.removeValue(forKey: oldest)?.request.cancel()
+        pendingOrder.removeFirst()
+      }
+      pendingOrder.append(clientID)
+    }
+    pending[clientID] = job
+    let shouldStart = !draining
+    draining = true
+    pendingLock.unlock()
+    if shouldStart { queue.async { self.drain() } }
+  }
+
+  private func drain() {
+    while true {
+      pendingLock.lock()
+      guard let clientID = pendingOrder.first, let job = pending.removeValue(forKey: clientID) else {
+        draining = false
+        pendingLock.unlock()
+        return
+      }
+      pendingOrder.removeFirst()
+      pendingLock.unlock()
+      autoreleasepool {
+        guard !job.request.isCancelled else { return }
+        let delivery = Delivery(colors: colorize(job))
+        guard !job.request.isCancelled else { return }
+        DispatchQueue.main.async {
+          if !job.request.isCancelled { job.completion(delivery.colors) }
+        }
+      }
+    }
+  }
+
+  private func colorize(_ job: Job) -> NSAttributedString? {
+    if !initialized {
+      initialized = true
+      engine = Highlighter()
+      if let engine = engine {
+        engine.ignoreIllegals = true
+        supported = Set(engine.supportedLanguages())
+      }
+    }
+    // No autodetection. Unknown grammars and missing SPM resources retain plain source.
+    guard let engine = engine, supported.contains(job.language) else { return nil }
+    let digest = SHA256.hash(data: Data(job.source.utf8)).map { String(format: "%02x", $0) }.joined()
+    let key = "pythagoras-v1:\(job.dark):\(job.language):\(digest)"
+    if let hit = cache[key] {
+      recency.removeAll { $0 == key }
+      recency.append(key)
+      return hit.colors
+    }
+    if activeDark != job.dark {
+      guard engine.setTheme(job.dark ? "atom-one-dark" : "atom-one-light", withFont: "Menlo", ofSize: 14) else { return nil }
+      activeDark = job.dark
+    }
+    guard !job.request.isCancelled,
+          let highlighted = engine.highlight(job.source, as: job.language, doFastRender: true),
+          highlighted.string.utf8.elementsEqual(job.source.utf8),
+          !job.request.isCancelled else { return nil }
+
+    // Geometry belongs to the existing UITextView. Export foreground colors only.
+    let colors = NSMutableAttributedString(string: job.source)
+    var runs = 0
+    highlighted.enumerateAttribute(.foregroundColor, in: NSRange(location: 0, length: highlighted.length)) { value, range, _ in
+      guard let color = value as? UIColor, let mapped = PythagorasSyntaxColors.remap(color, dark: job.dark) else { return }
+      colors.addAttribute(.foregroundColor, value: mapped, range: range)
+      runs += 1
+    }
+    let immutable = NSAttributedString(attributedString: colors)
+    let cost = immutable.length * 2 + runs * 96 + key.utf8.count
+    if cost <= maximumCacheCost {
+      while cache.count >= maximumCacheEntries || cacheCost + cost > maximumCacheCost {
+        guard let oldest = recency.first else { break }
+        recency.removeFirst()
+        cacheCost -= cache.removeValue(forKey: oldest)?.cost ?? 0
+      }
+      cache[key] = CachedResult(colors: immutable, cost: cost)
+      cacheCost += cost
+      recency.append(key)
+    }
+    return immutable
+  }
+}
+
+private enum PythagorasSyntaxColors {
+  // Atom One token colors map to our own graphite-safe palette. Base text keeps the configured color.
+  private static let dark: [UInt32: UInt32] = [
+    0x5C6370: 0xA4A39A, // comment
+    0xC678DD: 0xC8A0C9, // keyword
+    0xE06C75: 0xD9A3A4, // tag / name
+    0x56B6C2: 0xA4BDDA, // literal
+    0x98C379: 0xA6C39E, // string
+    0xD19A66: 0xBEADD6, // number / property
+    0x61AEEE: 0xA4BDDA, // title / meta
+    0xE6C07B: 0xD6C29E  // built-in
+  ]
+  private static let light: [UInt32: UInt32] = [
+    0xA0A1A7: 0x65655F,
+    0xA626A4: 0x6F3973,
+    0xE45649: 0x944A4E,
+    0x0184BB: 0x365D83,
+    0x50A14F: 0x3B653A,
+    0x986801: 0x715480,
+    0x4078F2: 0x365D83,
+    0xC18401: 0x795F2D
+  ]
+  static func remap(_ color: UIColor, dark isDark: Bool) -> UIColor? {
+    var r: CGFloat = 0, g: CGFloat = 0, b: CGFloat = 0, a: CGFloat = 0
+    guard color.getRed(&r, green: &g, blue: &b, alpha: &a) else { return nil }
+    let rgb = (UInt32((r * 255).rounded()) << 16) | (UInt32((g * 255).rounded()) << 8) | UInt32((b * 255).rounded())
+    guard let mapped = (isDark ? dark : light)[rgb] else { return nil }
+    return UIColor(red: CGFloat((mapped >> 16) & 255) / 255, green: CGFloat((mapped >> 8) & 255) / 255,
+                   blue: CGFloat(mapped & 255) / 255, alpha: 1)
+  }
+}
+#endif
