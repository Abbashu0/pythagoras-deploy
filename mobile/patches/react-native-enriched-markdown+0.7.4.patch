+  func submit(source: String, language: String, dark: Bool, clientID: String,
+              request: ENRMSyntaxHighlightRequest, completion: @escaping (NSAttributedString?) -> Void) {
+    let job = Job(source: source, language: language, dark: dark, request: request, completion: completion)
+    guard (source as NSString).length <= maximumSourceUTF16 else {
+      DispatchQueue.main.async { if !job.request.isCancelled { job.completion(nil) } }
+      return
+    }
+    pendingLock.lock()
+    // A streaming view replaces its pending job rather than enqueueing every delta.
+    if let old = pending[clientID] {
+      old.request.cancel()
+    } else {
+      if pending.count >= maximumPendingClients, let oldest = pendingOrder.first {
+        pending.removeValue(forKey: oldest)?.request.cancel()
+        pendingOrder.removeFirst()
+      }
+      pendingOrder.append(clientID)
+    }
+    pending[clientID] = job
+    let shouldStart = !draining
+    draining = true
+    pendingLock.unlock()
+    if shouldStart { queue.async { self.drain() } }
+  }
+
+  private func drain() {
+    while true {
+      pendingLock.lock()
+      guard let clientID = pendingOrder.first, let job = pending.removeValue(forKey: clientID) else {
+        draining = false
+        pendingLock.unlock()
+        return
+      }
+      pendingOrder.removeFirst()
+      pendingLock.unlock()
+      autoreleasepool {
+        guard !job.request.isCancelled else { return }
+        let delivery = Delivery(colors: colorize(job))
+        guard !job.request.isCancelled else { return }
+        DispatchQueue.main.async {
+          if !job.request.isCancelled { job.completion(delivery.colors) }
+        }
+      }
+    }
+  }
+
+  private func colorize(_ job: Job) -> NSAttributedString? {
+    if !initialized {
+      initialized = true
+      engine = Highlighter()
+      if let engine = engine {
+        engine.ignoreIllegals = true
+        supported = Set(engine.supportedLanguages())
+      }
+    }
+    // No autodetection. Unknown grammars and missing SPM resources retain plain source.
+    guard let engine = engine, supported.contains(job.language) else { return nil }
+    let digest = SHA256.hash(data: Data(job.source.utf8)).map { String(format: "%02x", $0) }.joined()
+    let key = "pythagoras-v1:\(job.dark):\(job.language):\(digest)"
+    if let hit = cache[key] {
+      recency.removeAll { $0 == key }
+      recency.append(key)
+      return hit.colors
+    }
+    if activeDark != job.dark {
+      guard engine.setTheme(job.dark ? "atom-one-dark" : "atom-one-light", withFont: "Menlo", ofSize: 14) else { return nil }
+      activeDark = job.dark
+    }
+    guard !job.request.isCancelled,
+          let highlighted = engine.highlight(job.source, as: job.language, doFastRender: true),
+          highlighted.string.utf8.elementsEqual(job.source.utf8),
+          !job.request.isCancelled else { return nil }
+
+    // Geometry belongs to the existing UITextView. Export foreground colors only.
+    let colors = NSMutableAttributedString(string: job.source)
+    var runs = 0
+    highlighted.enumerateAttribute(.foregroundColor, in: NSRange(location: 0, length: highlighted.length)) { value, range, _ in
+      guard let color = value as? UIColor, let mapped = PythagorasSyntaxColors.remap(color, dark: job.dark) else { return }
+      colors.addAttribute(.foregroundColor, value: mapped, range: range)
+      runs += 1
+    }
+    let immutable = NSAttributedString(attributedString: colors)
+    let cost = immutable.length * 2 + runs * 96 + key.utf8.count
+    if cost <= maximumCacheCost {
+      while cache.count >= maximumCacheEntries || cacheCost + cost > maximumCacheCost {
+        guard let oldest = recency.first else { break }
+        recency.removeFirst()
+        cacheCost -= cache.removeValue(forKey: oldest)?.cost ?? 0
+      }
+      cache[key] = CachedResult(colors: immutable, cost: cost)
+      cacheCost += cost
+      recency.append(key)
+    }
+    return immutable
+  }
+}
