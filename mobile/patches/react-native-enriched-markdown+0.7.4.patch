+  [super layoutSubviews];
+  CGFloat width = self.bounds.size.width;
+  CGFloat headerHeight = [self headerHeight];
+  CGFloat padding = self.config.codeBlockPadding;
+  _header.frame = CGRectMake(0, 0, width, headerHeight);
+  CGFloat previewControlWidth = 0;
+#if ENRICHED_MARKDOWN_PREVIEW
+  if (_previewLanguage) {
+    previewControlWidth = 88;
+    _modeControl.frame = CGRectMake(MAX(0, width - padding - previewControlWidth), 0, previewControlWidth, MAX(44, headerHeight));
+  }
+#endif
+  CGFloat copySlot = _previewing ? 0 : 52;
+  _language.frame = CGRectMake(padding, 0, MAX(0, width - padding * 2 - previewControlWidth - copySlot), headerHeight);
+  // Preserve the 44pt copy slot and its optical padding. Eligible blocks add
+  // the native mode control to its right; no glyph/x-position polish here.
+  _copyButton.frame = CGRectMake(MAX(0, width - padding - 44 - (previewControlWidth ? previewControlWidth + 8 : 0)), 0, 44, MAX(44, headerHeight));
