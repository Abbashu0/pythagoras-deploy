+      @"assembly": @"Assembly", @"asm": @"Assembly", @"x86asm": @"Assembly", @"solidity": @"Solidity", @"graphql": @"GraphQL", @"gql": @"GraphQL", @"dockerfile": @"Dockerfile", @"docker": @"Dockerfile", @"nginx": @"Nginx", @"diff": @"diff", @"patch": @"diff",
+      @"regex": @"regex", @"regexp": @"regex", @"latex": @"LaTeX", @"tex": @"LaTeX", @"mermaid": @"Mermaid", @"react": @"React", @"vue": @"Vue", @"svelte": @"Svelte", @"prisma": @"Prisma", @"sqlite": @"SQLite",
+      @"scss": @"SCSS", @"less": @"Less", @"makefile": @"Makefile", @"make": @"Makefile", @"cmake": @"CMake", @"gitconfig": @"git config", @"git-config": @"git config", @".env": @".env", @"env": @".env",
+      @"http": @"HTTP", @"https": @"HTTP", @"csv": @"CSV", @"plist": @"plist", @"swiftui": @"SwiftUI", @"react-native": @"React Native", @"reactnative": @"React Native", @"expo-config": @"Expo config", @"expoconfig": @"Expo config", @"expo": @"Expo config", @"pseudocode": @"Pseudocode" };
+  });
+  NSString *trimmed = ENRMSanitizedCodeLanguage(language);
+  return labels[trimmed.lowercaseString] ?: (trimmed.length ? trimmed : @"Plain text");
+}
+NSString *ENRMCodeHighlightLanguage(NSString *language)
+{
+  NSString *normalized = ENRMSanitizedCodeLanguage(language).lowercaseString;
+  if (normalized.length == 0 || [@[@"text", @"txt", @"plaintext", @"plain", @"plain-text", @"none", @"no-language", @"csv", @"pseudocode"] containsObject:normalized]) return nil;
+  static NSDictionary<NSString *, NSString *> *grammars;
+  static dispatch_once_t once;
+  dispatch_once(&once, ^{
+    // Metadata aliases/families only. Content never selects a grammar.
+    grammars = @{ @"js": @"javascript", @"jsx": @"javascript", @"react": @"javascript", @"react-native": @"javascript", @"reactnative": @"javascript",
+      @"ts": @"typescript", @"tsx": @"typescript", @"py": @"python", @"sh": @"bash", @"shell": @"bash", @"ps1": @"powershell", @"pwsh": @"powershell", @"cmd": @"dos", @"bat": @"dos", @"batch": @"dos",
+      @"jsonc": @"json", @"expo-config": @"json", @"expoconfig": @"json", @"expo": @"json", @"yml": @"yaml", @"toml": @"ini", @"gitconfig": @"ini", @"git-config": @"ini", @".env": @"ini", @"env": @"ini",
+      @"html": @"xml", @"plist": @"xml", @"vue": @"xml", @"svelte": @"xml", @"sqlite": @"sql", @"swiftui": @"swift", @"objc": @"objectivec", @"objective-c": @"objectivec",
+      @"c++": @"cpp", @"cs": @"csharp", @"c#": @"csharp", @"rb": @"ruby", @"pl": @"perl", @"hs": @"haskell", @"ex": @"elixir", @"clj": @"clojure", @"fs": @"fsharp", @"f#": @"fsharp",
+      @"asm": @"x86asm", @"assembly": @"x86asm", @"rs": @"rust", @"golang": @"go", @"gql": @"graphql", @"docker": @"dockerfile", @"patch": @"diff", @"tex": @"latex", @"md": @"markdown", @"make": @"makefile", @"https": @"http" };
+  });
+  return grammars[normalized] ?: normalized;
+}
+NSString *ENRMCodePreviewLanguage(NSString *language)
+{
+  // Exact original metadata families only; highlighting aliases and sanitized
+  // display labels never grant an executable preview capability.
+  NSString *normalized = [(language ?: @"") stringByTrimmingCharactersInSet:[NSCharacterSet whitespaceAndNewlineCharacterSet]].lowercaseString;
+  return [@[@"html", @"mermaid"] containsObject:normalized] ? normalized : nil;
+}
+NSString *ENRMRawCodeContent(MarkdownASTNode *node)
+{
+  // AST content only: never stringify Markdown, trim indentation, or include a fence/language.
+  NSMutableString *raw = [NSMutableString stringWithString:node.content ?: @""];
+  for (MarkdownASTNode *child in node.children) [raw appendString:ENRMRawCodeContent(child)];
+  return raw;
+}
