+// Pythagoras: isolate embedded Latin phrases at the parsed attributed-text boundary.
+// Never insert characters into Markdown or copied text; syntax has already been parsed.
+static void ENRMApplyRTLInlineDirections(NSMutableAttributedString *output, NSRange paragraphRange)
+{
+  static NSRegularExpression *latinRuns;
+  static dispatch_once_t once;
+  dispatch_once(&once, ^{
+    latinRuns = [NSRegularExpression regularExpressionWithPattern:@"[A-Za-z][A-Za-z0-9_]*(?:(?:['’.-][A-Za-z0-9_]+)|(?:[ \\t]+[A-Za-z][A-Za-z0-9_]*))*" options:0 error:nil];
+  });
+  for (NSTextCheckingResult *match in [latinRuns matchesInString:output.string options:0 range:paragraphRange]) {
+    __block BOOL protected = NO;
+    [output enumerateAttributesInRange:match.range options:0 usingBlock:^(NSDictionary *attributes, NSRange range, BOOL *stop) {
+      if (attributes[CodeAttributeName] || attributes[CodeBlockAttributeName] || attributes[NSLinkAttributeName] || attributes[NSAttachmentAttributeName]) { protected = YES; *stop = YES; }
+    }];
+    NSString *text = [output.string substringWithRange:match.range];
+    if (protected || [text hasPrefix:@"http"] || [text hasPrefix:@"www"]) continue;
+    [output addAttribute:NSWritingDirectionAttributeName value:@[ @(NSWritingDirectionLeftToRight | NSWritingDirectionEmbedding) ] range:match.range];
+  }
+}
