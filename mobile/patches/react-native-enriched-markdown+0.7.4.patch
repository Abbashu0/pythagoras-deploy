+  [_modeControl applyPrimaryColor:self.config.paragraphColor dark:(0.2126 * r + 0.7152 * g + 0.0722 * b) < 0.5];
+  _copyButton.hidden = _previewing;
+  _horizontalScroll.hidden = _previewing;
+  if (_previewing) [self updatePreviewPresentation];
+#endif
+  [self setNeedsLayout];
