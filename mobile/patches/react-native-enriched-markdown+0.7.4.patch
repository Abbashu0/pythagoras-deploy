+#if canImport(UIKit)
+import UIKit
+
+/// A source snapshot viewer, not a Markdown parser. It uses the same bounded
+/// foreground-only syntax service and the same non-wrapping TextKit contract.
+private final class ENRMFullscreenSource: UIView {
+  private let scroll = UIScrollView()
+  private let text = UITextView()
+  private var request: ENRMSyntaxHighlightRequest?
+  private let clientID = UUID().uuidString
+  private var documentWidth: CGFloat = 1
+  private var documentHeight: CGFloat = 1
+
+  init(source: NSAttributedString, language: String?, dark: Bool) {
+    super.init(frame: .zero)
+    clipsToBounds = true
+    scroll.clipsToBounds = true
+    scroll.isDirectionalLockEnabled = true
+    scroll.bounces = false
+    scroll.contentInsetAdjustmentBehavior = .never
+    scroll.semanticContentAttribute = .forceLeftToRight
+    addSubview(scroll)
+    text.isEditable = false
+    text.isSelectable = true
+    text.isScrollEnabled = false
+    text.backgroundColor = .clear
+    text.semanticContentAttribute = .forceLeftToRight
+    text.textAlignment = .left
+    text.textContainer.widthTracksTextView = false
+    text.textContainer.lineFragmentPadding = 0
+    text.textContainer.lineBreakMode = .byClipping
+    text.textContainerInset = UIEdgeInsets(top: 12, left: 0, bottom: 12, right: 0)
+    text.attributedText = source.copy() as? NSAttributedString
+    text.textContainer.size = CGSize(width: CGFloat.greatestFiniteMagnitude, height: CGFloat.greatestFiniteMagnitude)
+    text.layoutManager.ensureLayout(for: text.textContainer)
+    let used = text.layoutManager.usedRect(for: text.textContainer)
+    documentWidth = max(1, ceil(used.maxX) + 1)
+    text.textContainer.size.width = documentWidth
+    text.layoutManager.ensureLayout(for: text.textContainer)
+    let final = text.layoutManager.usedRect(for: text.textContainer)
+    let codeFont = source.length > 0 ? source.attribute(.font, at: 0, effectiveRange: nil) as? UIFont : nil
+    let lineHeight = (codeFont ?? UIFont.monospacedSystemFont(ofSize: 14, weight: .regular)).lineHeight
+    documentHeight = ceil(max(lineHeight, max(final.maxY, text.layoutManager.extraLineFragmentRect.maxY))) + 24
+    scroll.addSubview(text)
+    let raw = source.string
+    if let language {
+      request = ENRMSyntaxHighlighterBridge.requestColors(forSource: raw, language: language,
+        dark: dark, clientID: clientID, completion: { [weak self] colors in
+          guard let self, let colors, colors.string.utf8.elementsEqual(raw.utf8),
+                self.text.attributedText.string.utf8.elementsEqual(raw.utf8) else { return }
+          self.text.textStorage.beginEditing()
+          colors.enumerateAttribute(.foregroundColor, in: NSRange(location: 0, length: colors.length)) { color, range, _ in
+            if let color { self.text.textStorage.addAttribute(.foregroundColor, value: color, range: range) }
+          }
+          self.text.textStorage.endEditing()
+        })
+    }
+  }
+  required init?(coder: NSCoder) { fatalError("init(coder:) is unavailable") }
+  func cancelHighlight() { request?.cancel(); request = nil }
+  deinit { request?.cancel() }
+  override func layoutSubviews() {
+    super.layoutSubviews()
+    scroll.frame = bounds
+    text.frame = CGRect(x: 12, y: 0, width: documentWidth, height: documentHeight)
+    scroll.contentSize = CGSize(width: max(bounds.width, documentWidth + 24), height: documentHeight)
+  }
+}
+
+/// Dedicated native fullScreen presentation. Source/Preview here changes only
+/// this snapshot. Closing never measures, anchors or scrolls the conversation.
+@objc(ENRMCodeFullscreenController)
+public final class ENRMCodeFullscreenController: UIViewController {
+  private let source: NSAttributedString
+  private let kind: String
+  private let language: String?
+  private let dark: Bool
+  private let surfaceColor: UIColor
+  private let primaryColor: UIColor
+  private let secondaryColor: UIColor
+  @objc public var controlSurfaceColor: UIColor?
+  @objc public var controlSelectedSurfaceColor: UIColor?
+  @objc public var controlPressedSurfaceColor: UIColor?
+  @objc public var controlForegroundColor: UIColor?
+  @objc public var controlSelectedForegroundColor: UIColor?
+  @objc public var controlBorderColor: UIColor?
+  private let closeButton = UIButton(type: .system)
+  private let modes = ENRMPreviewSegments(items: ["Code", "Preview"])
+  private var sourceView: ENRMFullscreenSource?
+  private var preview: ENRMCodePreviewController?
+  private var disposed = false
+
+  @objc(initWithSource:kind:language:dark:backgroundColor:textColor:secondaryColor:)
+  public init(source: NSAttributedString, kind: String, language: String?, dark: Bool,
+    backgroundColor: UIColor, textColor: UIColor, secondaryColor: UIColor) {
+    self.source = source.copy() as! NSAttributedString
+    self.kind = kind
+    self.language = language
+    self.dark = dark
+    surfaceColor = backgroundColor
+    primaryColor = textColor
+    self.secondaryColor = secondaryColor
+    super.init(nibName: nil, bundle: nil)
+    modalPresentationStyle = .fullScreen
+    modalPresentationCapturesStatusBarAppearance = true
+  }
+  required init?(coder: NSCoder) { fatalError("init(coder:) is unavailable") }
+  public override var preferredStatusBarStyle: UIStatusBarStyle { dark ? .lightContent : .darkContent }
+
+  public override func viewDidLoad() {
+    super.viewDidLoad()
+    overrideUserInterfaceStyle = dark ? .dark : .light
+    view.backgroundColor = surfaceColor
+    view.clipsToBounds = true
+    let configuration: UIButton.Configuration
+    if #available(iOS 26.0, *), !UIAccessibility.isReduceTransparencyEnabled {
+      configuration = .glass()
+    } else { configuration = .tinted() }
+    var close = configuration
+    close.image = UIImage(systemName: "xmark", withConfiguration: UIImage.SymbolConfiguration(pointSize: 17, weight: .medium))
+    close.baseForegroundColor = controlForegroundColor ?? primaryColor
+    close.baseBackgroundColor = controlSurfaceColor
+    close.background.strokeColor = controlBorderColor
+    close.cornerStyle = .capsule
+    closeButton.configuration = close
+    closeButton.configurationUpdateHandler = { [weak self] button in
+      guard let self, var configuration = button.configuration else { return }
+      configuration.baseBackgroundColor = button.isHighlighted
+        ? (self.controlPressedSurfaceColor ?? self.controlSurfaceColor) : self.controlSurfaceColor
+      button.configuration = configuration
+    }
+    closeButton.accessibilityLabel = "إغلاق العرض الكامل"
+    closeButton.addTarget(self, action: #selector(closeViewer), for: .touchUpInside)
+    view.addSubview(closeButton)
+    modes.semanticContentAttribute = .forceLeftToRight
+    modes.selectedSegmentIndex = 1
+    modes.tintColor = primaryColor
+    modes.applyControlColors(surface: controlSurfaceColor, selectedSurface: controlSelectedSurfaceColor,
+      pressedSurface: controlPressedSurfaceColor, foreground: controlForegroundColor,
+      selectedForeground: controlSelectedForegroundColor, border: controlBorderColor)
+    modes.accessibilityLabel = "Code / Preview"
+    modes.addTarget(self, action: #selector(modeChanged), for: .valueChanged)
+    view.addSubview(modes)
+    showPreview()
+  }
+  @objc private func modeChanged() {
+    if modes.selectedSegmentIndex == 0 {
+      if sourceView == nil {
+        let code = ENRMFullscreenSource(source: source, language: language, dark: dark)
+        view.insertSubview(code, at: 0)
+        sourceView = code
+      }
+      sourceView?.isHidden = false
+      preview?.view.isHidden = true
+    } else { showPreview() }
+    view.setNeedsLayout()
+  }
+  private func showPreview() {
+    if preview == nil {
+      let content = ENRMCodePreviewController(kind: kind)
+      content.fullscreen = true
+      content.statusColor = secondaryColor
+      addChild(content)
+      view.insertSubview(content.view, at: 0)
+      content.didMove(toParent: self)
+      content.update(source: source.string, dark: dark, backgroundColor: surfaceColor, textColor: primaryColor)
+      preview = content
+    }
+    sourceView?.isHidden = true
+    preview?.view.isHidden = false
+  }
+  @objc private func closeViewer() {
+    dismiss(animated: !UIAccessibility.isReduceMotionEnabled) { [weak self] in self?.disposeViewer() }
+  }
+  private func disposeViewer() {
+    guard !disposed else { return }
+    disposed = true
+    sourceView?.cancelHighlight()
+    preview?.dispose()
+    preview?.willMove(toParent: nil)
+    preview?.view.removeFromSuperview()
+    preview?.removeFromParent()
+    preview = nil
+  }
+  public override func viewDidDisappear(_ animated: Bool) {
+    super.viewDidDisappear(animated)
+    if isBeingDismissed || presentingViewController == nil { disposeViewer() }
+  }
+  public override func viewDidLayoutSubviews() {
+    super.viewDidLayoutSubviews()
+    let top = view.safeAreaInsets.top + 8
+    closeButton.frame = CGRect(x: 16, y: top, width: 44, height: 44)
+    let modeWidth = min(200, max(88, view.bounds.width - 144))
+    modes.frame = CGRect(x: (view.bounds.width - modeWidth) / 2, y: top + 4, width: modeWidth, height: 36)
