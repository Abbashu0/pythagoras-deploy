+#if canImport(UIKit)
+import UIKit
+import WebKit
+import SwiftUI
+import MermaidKit
+
+private final class ENRMPreviewSegments: UISegmentedControl {
+  override func point(inside point: CGPoint, with event: UIEvent?) -> Bool {
+    bounds.insetBy(dx: 0, dy: -4).contains(point)
+  }
+}
+
+/// One standard segmented control on one genuine glass surface. The material is
+/// 36pt high; native segment hit testing fills the fixed 44pt header target.
+@objc(ENRMCodeModeControl)
+public final class ENRMCodeModeControl: UIControl {
+  private let material = UIVisualEffectView()
+  private let segments: ENRMPreviewSegments
+
+  @objc public var previewSelected: Bool {
+    get { segments.selectedSegmentIndex == 1 }
+    set {
+      segments.selectedSegmentIndex = newValue ? 1 : 0
+      segments.accessibilityValue = newValue ? "المعاينة" : "المصدر"
+    }
+  }
+
+  public override init(frame: CGRect) {
+    let source = UIImage(systemName: "chevron.left.forwardslash.chevron.right")!
+    let preview = UIImage(systemName: "play.fill")!
+    source.accessibilityLabel = "المصدر"
+    preview.accessibilityLabel = "المعاينة"
+    segments = ENRMPreviewSegments(items: [source, preview])
+    super.init(frame: frame)
+    semanticContentAttribute = .forceLeftToRight
+    material.layer.cornerRadius = 18
+    material.layer.cornerCurve = .continuous
+    material.clipsToBounds = true
+    addSubview(material)
+    material.contentView.addSubview(segments)
+    let clear = UIGraphicsImageRenderer(size: CGSize(width: 1, height: 1)).image { _ in }
+    segments.setBackgroundImage(clear, for: .normal, barMetrics: .default)
+    segments.setDividerImage(clear, forLeftSegmentState: .normal, rightSegmentState: .normal, barMetrics: .default)
+    segments.accessibilityLabel = "طريقة عرض الكود"
+    segments.addTarget(self, action: #selector(changed), for: .valueChanged)
+    previewSelected = false
+    updateMaterial()
+  }
+
+  required init?(coder: NSCoder) { fatalError("init(coder:) is unavailable") }
+
+  @objc public func applyPrimaryColor(_ color: UIColor, dark: Bool) {
+    overrideUserInterfaceStyle = dark ? .dark : .light
+    segments.tintColor = color
+    updateMaterial()
+  }
+
+  private func updateMaterial() {
+    if UIAccessibility.isReduceTransparencyEnabled {
+      material.effect = nil
+      material.backgroundColor = .secondarySystemBackground
+    } else if #available(iOS 26.0, *) {
+      let glass = UIGlassEffect(style: .regular)
+      glass.isInteractive = true
+      material.backgroundColor = .clear
+      material.effect = glass
+    } else {
+      material.backgroundColor = .clear
+      material.effect = UIBlurEffect(style: .systemThinMaterial)
+    }
+  }
+
+  @objc private func changed() {
+    segments.accessibilityValue = previewSelected ? "المعاينة" : "المصدر"
+    sendActions(for: .valueChanged)
+  }
+
+  public override func layoutSubviews() {
+    super.layoutSubviews()
+    material.frame = CGRect(x: 0, y: (bounds.height - 36) / 2, width: bounds.width, height: 36)
+    segments.frame = material.bounds
+  }
+
+  public override func hitTest(_ point: CGPoint, with event: UIEvent?) -> UIView? {
+    guard !isHidden, isUserInteractionEnabled, alpha > 0.01, bounds.contains(point) else { return nil }
+    return segments.hitTest(convert(point, to: segments), with: event) ?? self
+  }
+}
+
+/// Owned as a real child of the React view controller. MermaidKit's hosting
+/// controller is in turn a child of this controller; no unowned hosting views.
+@objc(ENRMCodePreviewController)
+public final class ENRMCodePreviewController: UIViewController, WKNavigationDelegate {
+  private let kind: String
+  private var htmlWebView: WKWebView?
+  private var mermaidHost: UIHostingController<AnyView>?
+  private let errorLabel = UILabel()
+  private var source = ""
+  private var appearanceKey = ""
+  private var loadingKey = ""
+  private var activeNavigation: WKNavigation?
+  private var allowInitialHTMLDocument = false
+  private var disposed = false
+  private var generation = 0
+
+  // Inline CSS only. No data/file/remote images, fonts, frames, scripts, forms,
+  // connections or origin inheritance. Additional source CSP cannot loosen it.
+  private static let htmlCSP = "default-src 'none'; script-src 'none'; style-src 'unsafe-inline'; img-src 'none'; font-src 'none'; connect-src 'none'; frame-src 'none'; object-src 'none'; media-src 'none'; base-uri 'none'; form-action 'none'"
+
+  @objc public init(kind: String) {
+    self.kind = kind
+    super.init(nibName: nil, bundle: nil)
+  }
+  required init?(coder: NSCoder) { fatalError("init(coder:) is unavailable") }
+
+  public override func viewDidLoad() {
+    super.viewDidLoad()
+    view.clipsToBounds = true
+    errorLabel.text = "تعذّر عرض المعاينة. يمكنك العودة إلى المصدر."
+    errorLabel.numberOfLines = 0
+    errorLabel.textAlignment = .center
+    errorLabel.font = .systemFont(ofSize: 14)
+    errorLabel.isHidden = true
+    errorLabel.accessibilityLabel = errorLabel.text
+    view.addSubview(errorLabel)
+    if kind == "html" {
+      let configuration = WKWebViewConfiguration()
+      configuration.websiteDataStore = .nonPersistent()
+      configuration.defaultWebpagePreferences.allowsContentJavaScript = false
+      configuration.preferences.javaScriptCanOpenWindowsAutomatically = false
+      // No scripts or message handlers are installed for model-owned HTML.
+      let web = WKWebView(frame: .zero, configuration: configuration)
+      web.navigationDelegate = self
+      web.isOpaque = false
+      web.scrollView.bounces = false
+      web.allowsBackForwardNavigationGestures = false
+      view.insertSubview(web, at: 0)
+      htmlWebView = web
+    }
+  }
+
+  @objc(updateWithSource:dark:backgroundColor:textColor:)
+  public func update(source: String, dark: Bool, backgroundColor: UIColor, textColor: UIColor) {
+    guard !disposed else { return }
+    loadViewIfNeeded()
+    let key = "\(dark)|\(Self.cssColor(backgroundColor))|\(Self.cssColor(textColor))"
+    guard self.source != source || appearanceKey != key else { return }
+    self.source = source
+    appearanceKey = key
+    generation += 1
+    overrideUserInterfaceStyle = dark ? .dark : .light
+    view.backgroundColor = backgroundColor
+    errorLabel.backgroundColor = backgroundColor
+    errorLabel.textColor = textColor
+    errorLabel.isHidden = true
+    htmlWebView?.isHidden = false
+    htmlWebView?.backgroundColor = backgroundColor
+    if kind == "html" {
+      // Native navigation completion coalesces pending HTML updates; no timer.
+      if activeNavigation == nil { loadLatestHTML() }
+    } else if kind == "mermaid" {
+      let revision = generation
+      let configuration = MermaidConfiguration(theme: dark ? .dark : .default,
+        securityLevel: .strict, source: .bundledDefault, backgroundColor: "transparent")
+      let diagram = MermaidView(source, configuration: configuration,
+        interaction: .panZoom, onLinkActivated: { _ in }, onError: { [weak self] _ in
+          guard let self, !self.disposed, self.generation == revision else { return }
+          self.showFailure()
+        })
+      let root = AnyView(diagram)
+      if let host = mermaidHost {
+        host.view.isHidden = false
+        host.rootView = root
+      } else {
+        let host = UIHostingController(rootView: root)
+        host.view.backgroundColor = .clear
+        addChild(host)
+        view.insertSubview(host.view, at: 0)
+        host.didMove(toParent: self)
+        mermaidHost = host
+      }
+      view.setNeedsLayout()
+    }
+  }
+
+  private func loadLatestHTML() {
+    guard !disposed, let web = htmlWebView else { return }
+    loadingKey = source + appearanceKey
+    allowInitialHTMLDocument = true
+    let background = Self.cssColor(view.backgroundColor ?? .clear)
+    let foreground = Self.cssColor(errorLabel.textColor ?? .label)
+    let document = "<!doctype html><html><head><meta charset=\"utf-8\"><meta http-equiv=\"Content-Security-Policy\" content=\"\(Self.htmlCSP)\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><style>html,body{margin:0;background:\(background);color:\(foreground);font-family:-apple-system,system-ui}body{padding:12px;box-sizing:border-box}</style></head><body>" + source + "</body></html>"
+    activeNavigation = web.loadHTMLString(document, baseURL: nil)
+    if activeNavigation == nil { showFailure() }
+  }
+
+  public func webView(_ webView: WKWebView, decidePolicyFor navigationAction: WKNavigationAction,
+    preferences: WKWebpagePreferences, decisionHandler: @escaping (WKNavigationActionPolicy, WKWebpagePreferences) -> Void) {
+    preferences.allowsContentJavaScript = false
+    let url = navigationAction.request.url
+    let initialDocument = url == nil || url?.absoluteString == "about:blank"
+    let allowed = !disposed && allowInitialHTMLDocument && initialDocument &&
+      navigationAction.navigationType == .other && navigationAction.targetFrame?.isMainFrame == true
+    if allowed { allowInitialHTMLDocument = false }
+    decisionHandler(allowed ? .allow : .cancel, preferences)
+  }
+
+  public func webView(_ webView: WKWebView, didFinish navigation: WKNavigation!) {
+    guard !disposed, navigation === activeNavigation else { return }
+    activeNavigation = nil
+    if loadingKey != source + appearanceKey { loadLatestHTML() }
+  }
+  public func webView(_ webView: WKWebView, didFail navigation: WKNavigation!, withError error: Error) {
+    navigationFailed(navigation)
+  }
+  public func webView(_ webView: WKWebView, didFailProvisionalNavigation navigation: WKNavigation!, withError error: Error) {
+    navigationFailed(navigation)
+  }
+  private func navigationFailed(_ navigation: WKNavigation?) {
+    guard !disposed, navigation === activeNavigation else { return }
+    activeNavigation = nil
+    if loadingKey != source + appearanceKey { loadLatestHTML() } else { showFailure() }
+  }
+  private func showFailure() {
+    // Never display/log engine errors or raw student/model content.
+    htmlWebView?.isHidden = true
+    mermaidHost?.view.isHidden = true
+    errorLabel.isHidden = false
+  }
+
+  public override func viewDidLayoutSubviews() {
+    super.viewDidLayoutSubviews()
+    htmlWebView?.frame = view.bounds
+    mermaidHost?.view.frame = view.bounds
+    errorLabel.frame = view.bounds.insetBy(dx: 20, dy: 20)
+  }
+
+  @objc public func dispose() {
+    guard !disposed else { return }
+    disposed = true
+    generation += 1
+    htmlWebView?.stopLoading()
+    htmlWebView?.navigationDelegate = nil
+    htmlWebView?.uiDelegate = nil
+    htmlWebView?.configuration.userContentController.removeAllScriptMessageHandlers()
+    htmlWebView?.configuration.userContentController.removeAllUserScripts()
+    htmlWebView?.removeFromSuperview()
+    htmlWebView = nil
+    activeNavigation = nil
+    if let host = mermaidHost {
+      // Root replacement invokes MermaidKit.dismantleUIView, which stops its
+      // WKWebView and removes every engine script handler before release.
+      host.rootView = AnyView(EmptyView())
+      host.willMove(toParent: nil)
+      host.view.removeFromSuperview()
+      host.removeFromParent()
+      mermaidHost = nil
+    }
+    source = ""
+  }
+
+  private static func cssColor(_ color: UIColor) -> String {
+    var r: CGFloat = 0, g: CGFloat = 0, b: CGFloat = 0, a: CGFloat = 1
+    color.getRed(&r, green: &g, blue: &b, alpha: &a)
+    return "rgba(\(Int(r * 255)),\(Int(g * 255)),\(Int(b * 255)),\(a))"
+  }
+}
+#endif
