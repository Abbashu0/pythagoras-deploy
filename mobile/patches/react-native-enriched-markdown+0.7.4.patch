+        const distance = Math.hypot(points[0].x - points[1].x, points[0].y - points[1].y);
+        const nextScale = clampScale(pinchStart.scale * distance / pinchStart.distance);
+        const ratio = nextScale / pinchStart.scale;
+        tx = midX - (pinchStart.x - pinchStart.tx) * ratio;
+        ty = midY - (pinchStart.y - pinchStart.ty) * ratio;
+        scale = nextScale;
+      } else return;
+      apply();
+    };
+    const up = event => {
+      if (!pointers.has(event.pointerId)) return;
+      consume(event);
+      pointers.delete(event.pointerId);
+      try { viewport.releasePointerCapture(event.pointerId); } catch (_) {}
+      // A surviving pointer begins a NEW one-finger baseline at the current
+      // transform, not the origin recorded before the two-finger pinch.
+      rebase();
+      if (pointers.size === 0) { gestureClaimed = false; status('interaction-ended'); }
+    };
+    const wheel = event => {
+      if (!findSurface(event)) return;
+      consume(event);
+      if (pointers.size) return;
+      syncFromStage();
+      const point = position(event), nextScale = clampScale(scale * Math.exp(-event.deltaY * 0.0015));
+      const ratio = nextScale / scale;
