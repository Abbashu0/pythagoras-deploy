+  private var onRendered: (() -> Void)?
+  private var onInteractionChanged: ((Bool) -> Void)?
+  private let minScale: Double
+  private let maxScale: Double
+  private var attached = true
+  private static let handler = "pythagorasMermaidRendered"
+  private static let script = #"""
+  (() => {
+    if (window.__pythagorasMermaidObserver) return;
+    let lastSVG = null;
+    const rendered = () => {
+      const svg = document.querySelector('#container svg');
