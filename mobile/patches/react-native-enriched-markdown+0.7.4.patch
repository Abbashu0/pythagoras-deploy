+    };
+    const syncFromStage = () => {
+      const matrix = new DOMMatrixReadOnly(getComputedStyle(stage).transform);
+      const actualScale = Math.hypot(matrix.a, matrix.b);
+      scale = Number.isFinite(actualScale) && actualScale > 0 ? clampScale(actualScale) : 1;
