+  _language.accessibilityLabel = [@"لغة الكود: " stringByAppendingString:_language.text];
+  _copyButton.tintColor = [self.config.codeBlockColor colorWithAlphaComponent:0.8];
+  _copyButton.accessibilityLabel = [NSString stringWithFormat:@"%@ الكود — %@", self.copyLabel, _language.text];
