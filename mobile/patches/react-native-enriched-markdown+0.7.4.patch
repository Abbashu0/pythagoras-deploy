+#import "ENRMCodeLanguage.h"
+#import "MarkdownASTNode.h"
+NSString *ENRMCodeLanguageLabel(NSString *language)
+{
+  static NSDictionary<NSString *, NSString *> *labels;
+  static dispatch_once_t once;
+  dispatch_once(&once, ^{
+    labels = @{ @"text": @"Plain text", @"txt": @"Plain text", @"plaintext": @"Plain text",
+      @"python": @"Python", @"py": @"Python", @"typescript": @"TypeScript", @"ts": @"TypeScript", @"tsx": @"TypeScript",
+      @"javascript": @"JavaScript", @"js": @"JavaScript", @"jsx": @"JavaScript", @"json": @"JSON", @"html": @"HTML", @"css": @"CSS",
+      @"bash": @"Bash", @"sh": @"Shell", @"shell": @"Shell", @"sql": @"SQL", @"swift": @"Swift", @"kotlin": @"Kotlin",
+      @"java": @"Java", @"c": @"C", @"cpp": @"C++", @"c++": @"C++", @"csharp": @"C#", @"cs": @"C#",
+      @"rust": @"Rust", @"go": @"Go", @"yaml": @"YAML", @"yml": @"YAML", @"xml": @"XML", @"markdown": @"Markdown", @"md": @"Markdown" };
+  });
+  NSMutableString *safe = [NSMutableString string];
+  NSString *input = language ?: @"";
+  [input enumerateSubstringsInRange:NSMakeRange(0, input.length) options:NSStringEnumerationByComposedCharacterSequences usingBlock:^(NSString *part, NSRange range, NSRange enclosing, BOOL *stop) {
+    if (safe.length >= 32) { *stop = YES; return; }
+    if ([part rangeOfCharacterFromSet:[NSCharacterSet controlCharacterSet]].location == NSNotFound && [part rangeOfCharacterFromSet:[NSCharacterSet characterSetWithCharactersInString:@"\u202a\u202b\u202c\u202d\u202e\u2066\u2067\u2068\u2069"]].location == NSNotFound) [safe appendString:part];
+  }];
+  NSString *trimmed = [safe stringByTrimmingCharactersInSet:[NSCharacterSet whitespaceAndNewlineCharacterSet]];
+  return labels[trimmed.lowercaseString] ?: (trimmed.length ? trimmed : @"Plain text");
+}
+NSString *ENRMRawCodeContent(MarkdownASTNode *node)
+{
+  // AST content only: never stringify Markdown, trim indentation, or include a fence/language.
+  NSMutableString *raw = [NSMutableString stringWithString:node.content ?: @""];
+  for (MarkdownASTNode *child in node.children) [raw appendString:ENRMRawCodeContent(child)];
+  return raw;
+}
