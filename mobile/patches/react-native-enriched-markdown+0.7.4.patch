+  _horizontalScroll.scrollEnabled = contentWidth > width + 0.5;
+  _codeView.frame = CGRectMake(padding, 0, _documentWidth, _bodyHeight);
+  CGFloat maximum = MAX(0, contentWidth - width);
+  if (_horizontalScroll.contentOffset.x > maximum) _horizontalScroll.contentOffset = CGPointMake(maximum, 0);
+#if ENRICHED_MARKDOWN_PREVIEW
+  if (_previewing) _previewController.view.frame = CGRectMake(0, headerHeight, width, MAX(260, MIN(330, round(width * 0.85))));
+#endif
+}
+#if ENRICHED_MARKDOWN_PREVIEW
+- (void)previewModeChanged:(ENRMCodeModeControl *)control
+{
+  if (!_previewLanguage || _previewing == control.previewSelected) return;
+  _previewing = control.previewSelected;
+  _copyButton.hidden = _previewing;
+  _horizontalScroll.hidden = _previewing;
+  if (_previewing) [self updatePreviewPresentation];
+  else [self detachPreviewController];
+  [self setNeedsLayout];
+  // Explicit presentation action only. The owner validates native height;
+  // code/preview surfaces never write transcript offsets or React geometry.
+  if (self.onIntrinsicPresentationChanged) self.onIntrinsicPresentationChanged();
+}
+- (void)updatePreviewPresentation
+{
+  if (!_previewing || !_previewLanguage || !self.window) return;
+  UIViewController *parent = [self reactViewController];
+  if (!parent) return;
+  if (!_previewController) _previewController = [[ENRMCodePreviewController alloc] initWithKind:_previewLanguage];
+  if (_previewController.parentViewController != parent) {
+    [self detachPreviewController];
+    [parent addChildViewController:_previewController];
+    [self addSubview:_previewController.view];
+    [_previewController didMoveToParentViewController:parent];
+  }
+  CGFloat r = 1, g = 1, b = 1, a = 1;
+  [self.config.codeBlockBackgroundColor getRed:&r green:&g blue:&b alpha:&a];
+  [_previewController updateWithSource:_rawCode dark:(0.2126 * r + 0.7152 * g + 0.0722 * b) < 0.5 backgroundColor:self.config.codeBlockBackgroundColor textColor:self.config.paragraphColor];
+  [self setNeedsLayout];
+}
+- (void)detachPreviewController
+{
+  if (!_previewController.parentViewController) return;
+  [_previewController willMoveToParentViewController:nil];
+  [_previewController.view removeFromSuperview];
+  [_previewController removeFromParentViewController];
+}
+- (void)disposePreviewController
+{
+  [self detachPreviewController];
+  [_previewController dispose];
+  _previewController = nil;
+}
+- (void)willMoveToWindow:(UIWindow *)newWindow
+{
+  if (!newWindow) [self disposePreviewController];
+  [super willMoveToWindow:newWindow];
+}
+- (void)didMoveToWindow
+{
+  [super didMoveToWindow];
+  if (self.window && _previewing) [self updatePreviewPresentation];
+}
+#endif
+- (void)copyCode
+{
+  copyStringToPasteboard(_rawCode);
+  [_copyButton setImage:[UIImage systemImageNamed:@"checkmark"] forState:UIControlStateNormal];
+  _copyButton.accessibilityValue = @"تم النسخ";
+  UIAccessibilityPostNotification(UIAccessibilityAnnouncementNotification, @"تم النسخ");
+  NSUInteger revision = ++_copyFeedbackRevision;
+  __weak ENRMCodeBlockContainerView *weakSelf = self;
+  // Feedback only; no geometry change, polling, or streaming/layout timer.
+  dispatch_after(dispatch_time(DISPATCH_TIME_NOW, (int64_t)(1.3 * NSEC_PER_SEC)), dispatch_get_main_queue(), ^{
+    ENRMCodeBlockContainerView *view = weakSelf;
+    if (!view || view->_copyFeedbackRevision != revision) return;
+    [view->_copyButton setImage:[UIImage systemImageNamed:ENRMCodeCopySymbolName] forState:UIControlStateNormal];
+    view->_copyButton.accessibilityValue = nil;
+  });
+}
+@end
+#endif
