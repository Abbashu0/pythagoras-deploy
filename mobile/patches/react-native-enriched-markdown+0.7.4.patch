+#if canImport(UIKit)
+import UIKit
+import UIKit.UIGestureRecognizerSubclass
+
+/// Hit-scoped priority for an interactive viewport. Descendant WebKit/source
+/// recognizers keep their touches; ancestor scroll pans must wait for this
+/// recognizer to fail. No ancestor delegate, scroll flag or timer is changed.
+@objc(ENRMCodeGestureGate)
+public final class ENRMCodeGestureGate: UIGestureRecognizer, UIGestureRecognizerDelegate {
+  private var starts: [ObjectIdentifier: CGPoint] = [:]
+  private var touched = Set<UITouch>()
+  private let movementThreshold: CGFloat = 8
+  private let boundAncestorPans = NSHashTable<UIGestureRecognizer>.weakObjects()
+
+  @objc public init(viewport: UIView) {
+    super.init(target: nil, action: nil)
+    cancelsTouchesInView = false
+    delaysTouchesBegan = false
+    delaysTouchesEnded = false
+    delegate = self
+    viewport.addGestureRecognizer(self)
+  }
+  required init?(coder: NSCoder) { fatalError("init(coder:) is unavailable") }
+
+  /// Called from owned view mount/layout boundaries, never a timer. UIKit's
+  /// dependency is explicit; this recognizer participates only in its viewport.
+  @objc public func bindAncestorScrollViews() {
+    guard let viewport = view, viewport.window != nil else { return }
+    var ancestor = viewport.superview
+    while let current = ancestor {
+      if let scroll = current as? UIScrollView {
+        let pan = scroll.panGestureRecognizer
+        if boundAncestorPans.member(pan) == nil {
+          pan.require(toFail: self)
+          boundAncestorPans.add(pan)
+        }
+      }
+      ancestor = current.superview
+    }
+  }
+
+  public func gestureRecognizer(_ gestureRecognizer: UIGestureRecognizer, shouldReceive touch: UITouch) -> Bool {
+    guard isEnabled, let viewport = view, let touchedView = touch.view else { return false }
+    return touchedView === viewport || touchedView.isDescendant(of: viewport)
+  }
+
+  public override func touchesBegan(_ touches: Set<UITouch>, with event: UIEvent) {
+    for touch in touches {
+      touched.insert(touch)
+      starts[ObjectIdentifier(touch)] = touch.location(in: view)
+    }
+    if state == .possible && touched.count > 1 { state = .began }
+  }
+  public override func touchesMoved(_ touches: Set<UITouch>, with event: UIEvent) {
+    if state == .possible {
+      for touch in touches {
+        guard let start = starts[ObjectIdentifier(touch)] else { continue }
+        let point = touch.location(in: view)
+        let dx = point.x - start.x, dy = point.y - start.y
+        if (dx * dx + dy * dy).squareRoot() >= movementThreshold {
+          state = .began
+          break
+        }
+      }
+    } else if state == .began || state == .changed { state = .changed }
+  }
+  public override func touchesEnded(_ touches: Set<UITouch>, with event: UIEvent) {
+    touched.subtract(touches)
+    if touched.isEmpty { state = state == .possible ? .failed : .ended }
+  }
+  public override func touchesCancelled(_ touches: Set<UITouch>, with event: UIEvent) {
+    state = state == .possible ? .failed : .cancelled
+  }
+  public override func reset() {
+    starts.removeAll(keepingCapacity: true)
+    touched.removeAll(keepingCapacity: true)
+    super.reset()
+  }
+
+  private func isAncestorScrollPan(_ other: UIGestureRecognizer) -> Bool {
+    guard let viewport = view, let scroll = other.view as? UIScrollView,
+          scroll !== viewport, other === scroll.panGestureRecognizer else { return false }
+    return viewport.isDescendant(of: scroll)
+  }
+  public func gestureRecognizer(_ gestureRecognizer: UIGestureRecognizer,
+    shouldBeRequiredToFailBy otherGestureRecognizer: UIGestureRecognizer) -> Bool {
+    isEnabled && view?.window != nil && isAncestorScrollPan(otherGestureRecognizer)
+  }
+  public func gestureRecognizer(_ gestureRecognizer: UIGestureRecognizer,
+    shouldRecognizeSimultaneouslyWith otherGestureRecognizer: UIGestureRecognizer) -> Bool {
+    if isAncestorScrollPan(otherGestureRecognizer) { return false }
+    guard let viewport = view, let otherView = otherGestureRecognizer.view else { return false }
+    return otherView === viewport || otherView.isDescendant(of: viewport)
+  }
+}
