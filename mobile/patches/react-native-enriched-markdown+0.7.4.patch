+#if ENRICHED_MARKDOWN_PREVIEW
+  NSString *previewLanguage = ENRMCodePreviewLanguage(node.attributes[@"language"]);
+  if (![_previewLanguage isEqualToString:previewLanguage]) {
+    _previewing = NO;
+    [self disposePreviewController];
+    _previewLanguage = [previewLanguage copy];
+  }
+  if (_previewLanguage && !_modeControl) {
+    _modeControl = [[ENRMCodeModeControl alloc] initWithFrame:CGRectZero];
+    [_modeControl addTarget:self action:@selector(previewModeChanged:) forControlEvents:UIControlEventValueChanged];
+    [_header addSubview:_modeControl];
+  }
+  _modeControl.hidden = !_previewLanguage;
+  _modeControl.previewSelected = _previewing;
+#endif
+  _language.text = ENRMCodeLanguageLabel(node.attributes[@"language"]);
+  UIFont *font = self.config.codeBlockFont ?: [UIFont monospacedSystemFontOfSize:14 weight:UIFontWeightRegular];
+  _language.font = [UIFont systemFontOfSize:MAX(14, font.pointSize) weight:UIFontWeightMedium];
+  _language.textColor = self.config.paragraphColor;
+  _language.accessibilityLabel = [@"لغة الكود: " stringByAppendingString:_language.text];
+  _copyButton.tintColor = self.config.codeBlockColor;
+  _copyButton.accessibilityLabel = [NSString stringWithFormat:@"%@ الكود — %@", self.menuCopyLabel, _language.text];
+  self.backgroundColor = self.config.codeBlockBackgroundColor;
+  _header.backgroundColor = [UIColor clearColor];
+  self.layer.cornerRadius = self.config.codeBlockBorderRadius;
+  self.layer.cornerCurve = kCACornerCurveContinuous;
+  self.layer.borderColor = self.config.codeBlockBorderColor.CGColor;
+  self.layer.borderWidth = self.config.codeBlockBorderWidth;
+  NSMutableParagraphStyle *paragraph = [NSMutableParagraphStyle new];
+  paragraph.baseWritingDirection = NSWritingDirectionLeftToRight;
+  paragraph.alignment = NSTextAlignmentLeft;
+  paragraph.lineBreakMode = NSLineBreakByClipping;
+  if (self.config.codeBlockLineHeight > 0) {
+    paragraph.minimumLineHeight = self.config.codeBlockLineHeight;
+    paragraph.maximumLineHeight = self.config.codeBlockLineHeight;
+  }
+  NSDictionary *attributes = @{ NSFontAttributeName: font, NSForegroundColorAttributeName: self.config.codeBlockColor ?: [UIColor labelColor], NSParagraphStyleAttributeName: paragraph };
+  _codeView.attributedText = [[NSAttributedString alloc] initWithString:_rawCode attributes:attributes];
+  CGFloat width = 0;
+  for (NSString *line in [_rawCode componentsSeparatedByString:@"\n"]) width = MAX(width, [line sizeWithAttributes:attributes].width);
+  _codeView.textContainer.size = CGSizeMake(CGFLOAT_MAX, CGFLOAT_MAX);
+  CGFloat padding = self.config.codeBlockPadding;
+  _codeView.textContainerInset = UIEdgeInsetsMake(padding, 0, padding, 0);
+  [_codeView.layoutManager ensureLayoutForTextContainer:_codeView.textContainer];
+  CGRect used = [_codeView.layoutManager usedRectForTextContainer:_codeView.textContainer];
+  // TextKit intrinsic extent also accounts for tabs and composed glyphs.
+  _documentWidth = MAX(1, ceil(MAX(width, CGRectGetMaxX(used))) + 1);
+  _codeView.textContainer.size = CGSizeMake(_documentWidth, CGFLOAT_MAX);
+  [_codeView.layoutManager ensureLayoutForTextContainer:_codeView.textContainer];
+  used = [_codeView.layoutManager usedRectForTextContainer:_codeView.textContainer];
+  CGRect extra = _codeView.layoutManager.extraLineFragmentRect;
+  _bodyHeight = ceil(MAX(font.lineHeight, MAX(CGRectGetMaxY(used), CGRectGetMaxY(extra)))) + padding * 2;
