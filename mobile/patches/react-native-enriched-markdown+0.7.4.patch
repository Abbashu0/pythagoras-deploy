+}
+- (void)requestSyntaxColorsForLanguage:(NSString *)language
+{
+#if ENRICHED_MARKDOWN_SYNTAX
+  NSString *grammar = ENRMCodeHighlightLanguage(language);
+  if (!grammar || _rawCode.length > 32768) return;
+  CGFloat r = 1, g = 1, b = 1, a = 1;
+  [self.config.codeBlockBackgroundColor getRed:&r green:&g blue:&b alpha:&a];
+  BOOL dark = (0.2126 * r + 0.7152 * g + 0.0722 * b) < 0.5;
+  NSUInteger revision = _highlightRevision;
+  NSString *source = _rawCode;
+  __weak ENRMCodeBlockContainerView *weakSelf = self;
+  _highlightRequest = [ENRMSyntaxHighlighterBridge requestColorsForSource:source language:grammar dark:dark clientID:_highlightClientID completion:^(NSAttributedString *colors) {
+    ENRMCodeBlockContainerView *view = weakSelf;
+    if (!view || !colors || view->_highlightRevision != revision || ![view->_rawCode isEqualToString:source] || ![colors.string isEqualToString:source]) return;
+    // Apply colors only. Font/paragraph/source/selection/scroll offset and intrinsic size stay owned by the existing view.
+    [view->_codeView.textStorage beginEditing];
+    [colors enumerateAttribute:NSForegroundColorAttributeName inRange:NSMakeRange(0, colors.length) options:0 usingBlock:^(id color, NSRange range, BOOL *stop) {
+      if (color) [view->_codeView.textStorage addAttribute:NSForegroundColorAttributeName value:color range:range];
+    }];
+    [view->_codeView.textStorage endEditing];
+  }];
+#endif
+}
+- (void)dealloc
+{
