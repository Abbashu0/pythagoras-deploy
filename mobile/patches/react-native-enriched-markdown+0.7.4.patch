+      apply();
+    };
+    const doubleClick = event => {
+      if (!findSurface(event)) return;
+      consume(event);
+      if (pointers.size) return;
+      scale = clampScale(1); tx = 0; ty = 0; apply();
+    };
+    const clear = () => {
+      const wasActive = pointers.size > 0;
+      pointers.clear(); panStart = null; pinchStart = null;
+      gestureClaimed = false;
+      if (wasActive) status('interaction-ended');
+    };
+    const listeners = [['pointerdown', down], ['pointermove', move], ['pointerup', up],
+      ['pointercancel', up], ['lostpointercapture', up], ['wheel', wheel], ['dblclick', doubleClick]];
+    const options = { capture: true, passive: false };
+    for (const [name, handler] of listeners) document.addEventListener(name, handler, options);
+    window.addEventListener('pagehide', clear);
+    window.__pythagorasMermaidInteraction = { dispose: () => {
+      for (const [name, handler] of listeners) document.removeEventListener(name, handler, options);
+      window.removeEventListener('pagehide', clear);
+      clear(); stage = null; viewport = null;
+      delete window.__pythagorasMermaidInteraction;
+    } };
+  })();
+  """#
+
+  init(web: WKWebView, upstream: WKNavigationDelegate, minScale: Double, maxScale: Double,
+    onRendered: @escaping () -> Void, onInteractionChanged: @escaping (Bool) -> Void) {
+    self.web = web
+    self.upstream = upstream
+    self.onRendered = onRendered
+    self.onInteractionChanged = onInteractionChanged
+    self.minScale = minScale
+    self.maxScale = maxScale
+    super.init()
+    let userContent = web.configuration.userContentController
+    userContent.add(self, contentWorld: .defaultClient, name: Self.handler)
+    userContent.addUserScript(WKUserScript(source: ownedScript, injectionTime: .atDocumentEnd,
+      forMainFrameOnly: true, in: .defaultClient))
