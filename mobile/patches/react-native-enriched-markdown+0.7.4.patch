+@interface ENRMCodeBlockContainerView ()
+- (void)requestSyntaxColorsForLanguage:(NSString *)language;
+#if ENRICHED_MARKDOWN_PREVIEW
+- (void)updatePreviewPresentation;
+- (void)detachPreviewController;
+- (void)disposePreviewController;
+- (void)previewModeChanged:(ENRMCodeModeControl *)control;
+#endif
+@end
+
+// Shared by the initial icon and copy feedback reset; glyph polish is deferred.
+static NSString *const ENRMCodeCopySymbolName = @"doc.on.doc";
+
+// Pythagoras: native AST-backed code block, sharing the segmented Fabric height contract.
+@implementation ENRMCodeBlockContainerView {
+  UIView *_header;
+  UILabel *_language;
+  UIButton *_copyButton;
+  UIScrollView *_horizontalScroll;
+  UITextView *_codeView;
+  NSString *_rawCode;
+  CGFloat _documentWidth;
+  CGFloat _bodyHeight;
+  NSUInteger _copyFeedbackRevision;
+  NSUInteger _highlightRevision;
+  NSString *_highlightClientID;
+  BOOL _previewing;
+#if ENRICHED_MARKDOWN_PREVIEW
+  NSString *_previewLanguage;
+  ENRMCodeModeControl *_modeControl;
+  ENRMCodePreviewController *_previewController;
+#endif
+#if ENRICHED_MARKDOWN_SYNTAX
+  ENRMSyntaxHighlightRequest *_highlightRequest;
+#endif
+}
+- (instancetype)initWithConfig:(StyleConfig *)config
+{
+  self = [super initWithFrame:CGRectZero];
+  if (self) {
+    _config = config; _rawCode = @""; _menuCopyLabel = @"نسخ";
+    _highlightClientID = [NSUUID UUID].UUIDString;
+    self.clipsToBounds = YES;
+    self.semanticContentAttribute = UISemanticContentAttributeForceLeftToRight;
+    _header = [UIView new]; [self addSubview:_header];
+    _language = [UILabel new]; _language.numberOfLines = 1;
+    _language.isAccessibilityElement = YES; [_header addSubview:_language];
+    _horizontalScroll = [UIScrollView new];
+    _horizontalScroll.delegate = self;
+    _horizontalScroll.semanticContentAttribute = UISemanticContentAttributeForceLeftToRight;
+    _horizontalScroll.directionalLockEnabled = YES;
+    _horizontalScroll.alwaysBounceVertical = NO;
+    _horizontalScroll.showsVerticalScrollIndicator = NO;
+    _horizontalScroll.showsHorizontalScrollIndicator = YES;
+    _horizontalScroll.contentInsetAdjustmentBehavior = UIScrollViewContentInsetAdjustmentNever;
+    [self addSubview:_horizontalScroll];
+    _codeView = [UITextView new]; _codeView.editable = NO; _codeView.selectable = YES;
+    _codeView.scrollEnabled = NO; _codeView.backgroundColor = [UIColor clearColor];
+    _codeView.semanticContentAttribute = UISemanticContentAttributeForceLeftToRight;
+    _codeView.textAlignment = NSTextAlignmentLeft;
+    _codeView.textContainer.widthTracksTextView = NO;
+    _codeView.textContainer.lineFragmentPadding = 0;
+    _codeView.textContainer.lineBreakMode = NSLineBreakByClipping;
+    [_horizontalScroll addSubview:_codeView];
+    _copyButton = [UIButton buttonWithType:UIButtonTypeSystem];
+    [_copyButton setImage:[UIImage systemImageNamed:ENRMCodeCopySymbolName] forState:UIControlStateNormal];
+    [_copyButton addTarget:self action:@selector(copyCode) forControlEvents:UIControlEventTouchUpInside];
+    [_copyButton setPreferredSymbolConfiguration:[UIImageSymbolConfiguration configurationWithPointSize:18 weight:UIImageSymbolWeightRegular] forImageInState:UIControlStateNormal];
+    [_header addSubview:_copyButton];
+  }
+  return self;
+}
+- (CGFloat)headerHeight
+{
+  return MAX(44, ceil(_language.font.lineHeight + 16));
+}
+- (void)applyCodeNode:(MarkdownASTNode *)node
+{
+#if ENRICHED_MARKDOWN_SYNTAX
