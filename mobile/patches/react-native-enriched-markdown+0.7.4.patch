+private enum PythagorasSyntaxColors {
+  // Atom One token colors map to our own graphite-safe palette. Base text keeps the configured color.
+  private static let dark: [UInt32: UInt32] = [
+    0x5C6370: 0xA4A39A, // comment
+    0xC678DD: 0xC8A0C9, // keyword
+    0xE06C75: 0xD9A3A4, // tag / name
+    0x56B6C2: 0xA4BDDA, // literal
+    0x98C379: 0xA6C39E, // string
+    0xD19A66: 0xBEADD6, // number / property
+    0x61AEEE: 0xA4BDDA, // title / meta
+    0xE6C07B: 0xD6C29E  // built-in
+  ]
+  private static let light: [UInt32: UInt32] = [
+    0xA0A1A7: 0x65655F,
+    0xA626A4: 0x6F3973,
+    0xE45649: 0x944A4E,
+    0x0184BB: 0x365D83,
+    0x50A14F: 0x3B653A,
+    0x986801: 0x715480,
+    0x4078F2: 0x365D83,
+    0xC18401: 0x795F2D
+  ]
+  static func remap(_ color: UIColor, dark isDark: Bool) -> UIColor? {
+    var r: CGFloat = 0, g: CGFloat = 0, b: CGFloat = 0, a: CGFloat = 0
+    guard color.getRed(&r, green: &g, blue: &b, alpha: &a) else { return nil }
+    let rgb = (UInt32((r * 255).rounded()) << 16) | (UInt32((g * 255).rounded()) << 8) | UInt32((b * 255).rounded())
+    guard let mapped = (isDark ? dark : light)[rgb] else { return nil }
+    return UIColor(red: CGFloat((mapped >> 16) & 255) / 255, green: CGFloat((mapped >> 8) & 255) / 255,
+                   blue: CGFloat(mapped & 255) / 255, alpha: 1)
+  }
+}
+#endif
