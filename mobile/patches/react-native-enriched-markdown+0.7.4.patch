+// A request owns no view. Cancellation is checked both before grammar work and delivery.
+@objc(ENRMSyntaxHighlightRequest)
+public final class ENRMSyntaxHighlightRequest: NSObject, @unchecked Sendable {
+  private let lock = NSLock()
+  private var cancelled = false
+
+  @objc public func cancel() {
+    lock.lock()
+    cancelled = true
+    lock.unlock()
+  }
+
+  fileprivate var isCancelled: Bool {
+    lock.lock()
+    defer { lock.unlock() }
+    return cancelled
+  }
+}
+
+@objc(ENRMSyntaxHighlighterBridge)
+public final class ENRMSyntaxHighlighterBridge: NSObject {
+  private static let service = SyntaxHighlightService()
+
+  @objc(requestColorsForSource:language:dark:clientID:completion:)
+  public static func requestColors(
+    forSource source: String, language: String, dark: Bool, clientID: String,
+    completion: @escaping (NSAttributedString?) -> Void
+  ) -> ENRMSyntaxHighlightRequest {
+    let request = ENRMSyntaxHighlightRequest()
+    service.submit(source: source, language: language, dark: dark, clientID: clientID,
+                   request: request, completion: completion)
+    return request
+  }
+}
+
+private final class SyntaxHighlightService: @unchecked Sendable {
+  // Immutable inputs; cancellation is locked and the ObjC completion runs only on main.
+  private struct Job: @unchecked Sendable {
+    let source: String
+    let language: String
+    let dark: Bool
+    let request: ENRMSyntaxHighlightRequest
+    let completion: (NSAttributedString?) -> Void
+  }
+  private struct CachedResult {
+    let colors: NSAttributedString
+    let cost: Int
+  }
+  private struct Delivery: @unchecked Sendable {
+    let colors: NSAttributedString? // Immutable foreground-only snapshot.
+  }
+
+  private let queue = DispatchQueue(label: "com.pythagoras.markdown.syntax", qos: .utility)
+  private let pendingLock = NSLock()
+  private var pending: [String: Job] = [:]
+  private var pendingOrder: [String] = []
+  private var draining = false
+  private let maximumSourceUTF16 = 32768
+  private let maximumPendingClients = 128
+  private let maximumCacheEntries = 64
+  private let maximumCacheCost = 2 * 1024 * 1024
+
+  // Only the serial queue accesses the engine, themes and cache.
+  private var initialized = false
+  private var engine: Highlighter?
+  private var supported: Set<String> = []
+  private var activeDark: Bool?
+  private var cache: [String: CachedResult] = [:]
+  private var recency: [String] = []
+  private var cacheCost = 0
